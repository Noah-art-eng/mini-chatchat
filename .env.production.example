APP_ENV=production
APP_VERSION=1.0.0-rc.1
BUILD_TIME=
GIT_COMMIT=
LOG_LEVEL=INFO
HEALTH_DEPS_PUBLIC_DETAILS=false

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

EMBEDDING_MODEL=all-MiniLM-L6-v2

AUTH_SECRET_KEY=replace-with-a-long-random-production-secret
AUTH_ISSUER=mini-chatchat
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_NAME=mini_chatchat_refresh
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/auth
AUTH_RATE_LIMIT_MAX_FAILURES=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

FRONTEND_BASE_URL=https://your-domain.example
BACKEND_BASE_URL=https://your-domain.example/api
CORS_ORIGINS=https://your-domain.example
FRONTEND_HTTP_PORT=80

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/api/auth/oauth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=https://your-domain.example/api/auth/oauth/github/callback
